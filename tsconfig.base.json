{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@platform/shared/config": ["packages/shared/config/src/index.ts"],
      "@platform/shared/event-bus": ["packages/shared/event-bus/src/index.ts"],
      "@platform/shared/tenant-context": ["packages/shared/tenant-context/src/index.ts"],
      "@platform/shared/database": ["packages/shared/database/src/index.ts"],
      "@platform/shared/opensearch": ["packages/shared/opensearch/src/index.ts"],
      "@platform/modules/branding/contracts": ["packages/modules/branding/contracts/src/index.ts"],
      "@platform/modules/branding/src": ["packages/modules/branding/src/index.ts"],
      "@platform/modules/channels/contracts": ["packages/modules/channels/contracts/src/index.ts"],
      "@platform/modules/channels/src": ["packages/modules/channels/src/index.ts"],
      "@platform/modules/catalog/contracts": ["packages/modules/catalog/contracts/src/index.ts"],
      "@platform/modules/catalog/src": ["packages/modules/catalog/src/catalog.module.ts"],
      "@platform/modules/search/contracts": ["packages/modules/search/contracts/src/index.ts"],
      "@platform/modules/search/src": ["packages/modules/search/src/index.ts"],
      "@platform/shared/redis": ["packages/shared/redis/src/index.ts"],
      "@platform/modules/pricing/contracts": ["packages/modules/pricing/contracts/src/index.ts"],
      "@platform/modules/pricing/src": ["packages/modules/pricing/src/index.ts"],
      "@platform/modules/pricing/src/tenant-config/tenant-config.repository": ["packages/modules/pricing/src/tenant-config/tenant-config.repository.ts"],
      "@platform/modules/pricing/src/tenant-config/tenant-config.service": ["packages/modules/pricing/src/tenant-config/tenant-config.service.ts"],
      "@platform/modules/pricing/src/prices/prices.repository": ["packages/modules/pricing/src/prices/prices.repository.ts"],
      "@platform/modules/pricing/src/promotions/promotions.repository": ["packages/modules/pricing/src/promotions/promotions.repository.ts"],
      "@platform/modules/pricing/src/totals/totals.service": ["packages/modules/pricing/src/totals/totals.service.ts"],
      "@platform/modules/cart/contracts": ["packages/modules/cart/contracts/src/index.ts"],
      "@platform/modules/cart/src": ["packages/modules/cart/src/index.ts"],
      "@platform/modules/cart/src/cart.repository": ["packages/modules/cart/src/cart.repository.ts"],
      "@platform/modules/cart/src/cart.service": ["packages/modules/cart/src/cart.service.ts"],
      "@platform/modules/orders/contracts": ["packages/modules/orders/contracts/src/index.ts"],
      "@platform/modules/orders/src": ["packages/modules/orders/src/index.ts"],
      "@platform/modules/orders/src/checkout.service": ["packages/modules/orders/src/checkout.service.ts"],
      "@platform/shared/hooks": ["packages/shared/hooks/src/index.ts"],
      "@platform/shared/security": ["packages/shared/security/src/index.ts"],
      "@platform/shared/observability": ["packages/shared/observability/src/index.ts"],
      "@platform/api-client": ["packages/api-client/src/index.ts"],
      "@platform/api-client/*": ["packages/api-client/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
