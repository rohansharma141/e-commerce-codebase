{
  "name": "api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api-client/src",
  "projectType": "library",
  "tags": [
    "scope:api-client"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --config packages/api-client/codegen.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "fetch-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose cp api:/app/schema.gql packages/api-client/schema.graphql",
        "cwd": "{workspaceRoot}"
      }
    },
    "codegen-rest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "openapi-typescript http://localhost:3000/docs-json -o packages/api-client/src/generated/rest-api.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
